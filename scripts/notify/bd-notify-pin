#!/usr/bin/env bash
# bd-notify-pin — manage .beads/notify/pins.json: the seat -> live-herdr-pane
# map that `bd notify drain` delivers against.
#
# Usage:
#   bin/bd-notify-pin list                 show pins + live status
#   bin/bd-notify-pin get <seat>           print one pin as JSON
#   bin/bd-notify-pin set <seat> <session> <pane_id> [harness] [note]
#                                          write a pin manually
#   bin/bd-notify-pin forget <seat>        remove a pin
#
# Pins are set, never guessed: read the exact target off `herdr agent list`
# (or a lock/seat owner's message) and pass it to `set`. `list` reports a
# stale pin; re-pin it by hand. There is no discovery, scoring or title
# matching anywhere in the notify path - `bd notify drain` matches the pin
# exactly and holds+escalates when it is missing or dead.

set -euo pipefail
LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bd-notify-lib.sh
source "$LIB_DIR/bd-notify-lib.sh"

usage() { grep '^#   bin/bd-notify-pin' "$LIB_DIR/bd-notify-pin" | sed 's/^#   //'; exit 2; }

cmd="${1:-}"; shift || true

case "$cmd" in
    list)
        file="$(bd_notify_pins_file)"
        [ -f "$file" ] || { echo "(no pins yet: $file)"; exit 0; }
        seats="$(_jq -r 'keys[]' "$file")"
        [ -n "$seats" ] || { echo "(pins file empty)"; exit 0; }
        for seat in $seats; do
            pin="$(_jq -c --arg s "$seat" '.[$s]' "$file")"
            session="$(_jq -r '.session // ""'       <<<"$pin")"
            pane="$(_jq -r '.pane_id // ""'          <<<"$pin")"
            asid="$(_jq -r '.agent_session_id // ""' <<<"$pin")"
            if row="$(find_live_row "$session" "$pane" "$asid")"; then
                status="$(cut -f5 <<<"$row")"; kind="$(cut -f4 <<<"$row")"; lpane="$(cut -f2 <<<"$row")"
                note="$(_jq -r '.note // ""' <<<"$pin")"
                printf '%-12s -> %-10s %-8s %-8s %s (live: %s)\n' "$seat" "$session" "$kind" "$status" "$note" "$lpane"
            else
                printf '%-12s -> %-10s %-8s %-8s  ** STALE **\n' "$seat" "$session" "$(_jq -r '.harness // "?"' <<<"$pin")" "dead"
            fi
        done
        ;;

    get)
        seat="${1:?seat required}"; pin_get "$seat"
        ;;

    set)
        seat="${1:?seat required}"; session="${2:?session required}"; pane="${3:?pane_id required}"
        harness="${4:-}"; note="${5:-}"
        pin_write "$seat" "$session" "$pane" "" "$harness" "$note"
        echo "pinned $seat -> $session $pane"
        ;;

    forget)
        seat="${1:?seat required}"
        pin_delete "$seat"
        echo "forgot $seat"
        ;;

    *)
        usage
        ;;
esac
