#!/usr/bin/env bash
# Compatibility entrypoint. The bd registry is the only identity/endpoint writer.
set -euo pipefail
LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bd-notify-lib.sh
source "$LIB_DIR/bd-notify-lib.sh"
cmd="${1:-}"; shift || true
case "$cmd" in
    list) bd seat list --json ;;
    get) pin_get "${1:?seat required}" ;;
    set)
        pin_write "${1:?seat required}" "${2:?session required}" "${3:?pane required}" "" "${4:-}" "${5:-}"
        ;;
    forget) pin_delete "${1:?seat required}" ;;
    *) echo 'usage: bd-notify-pin list|get <seat>|set <seat> <session> <pane>|forget <seat>' >&2; exit 2 ;;
esac
